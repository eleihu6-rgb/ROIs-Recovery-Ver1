# 浏览器侧请求层使用的 API 基础路径。
# 本地开发保持 /api 时，Vite 会把请求代理到 pbs-server。
VITE_API_BASE_URL=/api

# SSO 按钮跳转使用的显式登录地址，可选。
# 留空时会基于 VITE_API_BASE_URL 自动拼出 /auth/sso/login。
VITE_SSO_LOGIN_URL=

# pbs-portal 本地开发服务器绑定地址。
# 使用 0.0.0.0 时，可通过 localhost 和同一局域网设备访问。
PBS_PORTAL_DEV_HOST=0.0.0.0

# pbs-portal 本地开发端口。
# 如果你改了这里，通常也要一起调整 pbs-server 的 CORS_ORIGIN。
PBS_PORTAL_DEV_PORT=3030

# 仅用于本地开发的 /api 代理目标地址。
# 本地联调时这里应指向正在运行的 pbs-server 根地址。
PBS_PORTAL_API_PROXY_TARGET=http://localhost:3002
