# ROIS-AI 开发环境配置
# 复制为 .env 后修改: cp .env.example .env

NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rois
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 航司连接串（应用服务使用）
# 占位符密码：复制为 .env 后替换为真实密码，请勿把真实密码提交进 .env.example
DATABASE_URL_F8=postgresql://f8:replace_with_f8_password@localhost:5432/rois?options=-c%20search_path%3Df8
DATABASE_URL_TG=postgresql://tg:replace_with_tg_password@localhost:5432/rois?options=-c%20search_path%3Dtg

# ── Redis（live-server）──────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Redis PBS（pbs-server）───────────────────────────────────────
REDIS_PBS_HOST=localhost
REDIS_PBS_PORT=6380
REDIS_PBS_URL=redis://localhost:6380

# ── 服务端口 ─────────────────────────────────────────────────────
LIVE_SERVER_PORT=3000
RULE_ENGINE_PORT=3001
PBS_SERVER_PORT=3002
GANTT_PORT=5173
PBS_WEB_PORT=5174
PO_ENGINE_PORT=8000
RO_ENGINE_PORT=8001

# ── PBS 模拟登录服务间鉴权（业务 URL / TTL 存 live.dictionary SYS_PARAM）──
# Generate with: openssl rand -base64 48
# Must match between live-server and pbs-server in the same environment.
PBS_INTERNAL_API_SECRET=O6+1q0STl8O+5id6dPepmF5A22MyTvO2vJGPK4cbVMrlgbvgDH0BU+dgZF6VJ8oO
