# Connector Server 环境配置
# 复制为 .env 后修改: cp .env.example .env

# 服务绑定地址与端口
HOST=0.0.0.0
PORT=3104

# 部署环境标识。development / test 允许使用开发默认值；
# production / staging / uat / demo 为生产类环境，会强制拒绝弱/默认 JWT_SECRET。
APP_ENV=development

# 数据库连接串（占位符密码：复制为 .env 后替换为真实密码）
DATABASE_URL=postgresql://f8:replace_with_f8_password@localhost:5432/rois?options=-c%20search_path%3Df8

# Redis
REDIS_URL=redis://localhost:6379

# Fastify 日志级别：fatal、error、warn、info、debug、trace
LOG_LEVEL=info

# 校验并签发 connector / admin JWT 的密钥。
# 生产类环境必须替换为至少 32 位的随机密钥，否则服务拒绝启动。
JWT_SECRET=replace-with-32-plus-char-random-secret

# 内部 Prometheus /metrics 暴露控制。
# METRICS_ENABLED=false 时不注册 /metrics；生产类环境若开启必须设置 METRICS_TOKEN，
# 否则服务拒绝启动。设置后抓取需带 Authorization: Bearer <token> 或 X-Metrics-Token 头。
METRICS_ENABLED=true
# METRICS_TOKEN=replace_with_random_metrics_token

# 对外回调 / 文档展示用的外部基址（可选）
# EXTERNAL_BASE_URL=https://connector.example.com
