{
  "name": "royce-travel-rn",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e:build:ios": "detox build --configuration ios.sim.debug",
    "test:e2e:build:android": "detox build --configuration android.emu.debug",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "test:e2e:android": "detox test --configuration android.emu.debug",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "testflight:preflight": "node scripts/testflight-preflight.cjs",
    "testflight:validate": "ASC_TELEMETRY_DISABLED=1 asc workflow validate",
    "testflight:plan": "ASC_TELEMETRY_DISABLED=1 asc workflow run --dry-run testflight_external",
    "testflight:release": "ASC_TELEMETRY_DISABLED=1 asc workflow run testflight_external",
    "check:assets": "node scripts/cityImageReport.mjs",
    "postinstall": "node scripts/fixRnSpacePaths.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@reduxjs/toolkit": "^2.3.0",
    "axios": "^1.7.7",
    "date-fns": "^4.1.0",
    "jsencrypt": "3.3.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-document-picker": "^9.3.1",
    "react-native-gesture-handler": "3.4.0",
    "react-native-keychain": "8.2.0",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.15.5",
    "react-native-webview": "13.17.0",
    "react-redux": "^9.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/eslint-config": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.7.2",
    "@types/jest": "^29.5.13",
    "@types/react": "19.2.14",
    "@types/react-test-renderer": "19.1.0",
    "babel-jest": "^29.7.0",
    "detox": "^20.26.2",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "react-test-renderer": "19.2.3",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >=25.0.0"
  }
}
