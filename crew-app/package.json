{
  "name": "royce-travel-rn",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e:build:ios": "detox build --configuration ios.sim.debug",
    "test:e2e:build:android": "detox build --configuration android.emu.debug",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "test:e2e:android": "detox test --configuration android.emu.debug",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "check:assets": "node scripts/cityImageReport.mjs",
    "postinstall": "node scripts/fixRnSpacePaths.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.0.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@reduxjs/toolkit": "^2.3.0",
    "axios": "^1.7.7",
    "date-fns": "^4.1.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-document-picker": "^9.3.1",
    "react-native-gesture-handler": "^2.20.2",
    "react-native-keychain": "^8.2.0",
    "react-native-reanimated": "3.10.1",
    "react-native-safe-area-context": "^4.11.0",
    "react-native-screens": "^3.34.0",
    "react-native-svg": "^15.2.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-webview": "^13.12.5",
    "react-redux": "^9.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "^0.74.87",
    "@react-native/eslint-config": "^0.74.87",
    "@react-native/metro-config": "^0.74.87",
    "@react-native/typescript-config": "^0.74.87",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.7.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^18.3.11",
    "@types/react-native-vector-icons": "^6.4.18",
    "babel-jest": "^29.7.0",
    "detox": "^20.26.2",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "react-test-renderer": "18.2.0",
    "typescript": "5.0.4"
  }
