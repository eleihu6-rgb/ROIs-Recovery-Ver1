# Copy to e2e/.env (gitignored) to retarget the Playwright suite WITHOUT editing the
# checked-in configs — config/*.config.ts auto-load it via config/load-env.ts, and any
# real env var or CI value overrides it. Leave it on localhost, or point it at a remote
# environment, e.g. the cr.rois.one sign-off gate:
#   GANTT_BASE_URL=https://cr.rois.one
#   GANTT_API_URL=https://cr.rois.one

# ─── Frontend URLs ──────────────────────────────────────────────
GANTT_BASE_URL=http://localhost:5173
PBS_PORTAL_BASE_URL=http://localhost:5174
PBS_APP_BASE_URL=http://localhost:8081

# ─── Backend API URLs ───────────────────────────────────────────
GANTT_API_URL=http://localhost:3000
PBS_API_URL=http://localhost:3002

# ─── Test Credentials ───────────────────────────────────────────
GANTT_TEST_USER=admin
GANTT_TEST_PASS=123456
PBS_TEST_USER=admin
PBS_TEST_PASS=123456

# ─── Database (for db-helper.ts, optional) ──────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rois
DB_USER=f8
DB_PASSWORD=replace_with_f8_password
DB_SCHEMA=f8

# ─── CI ─────────────────────────────────────────────────────────
CI=false
