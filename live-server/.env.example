# Server
HOST=0.0.0.0
PORT=3000

# 部署环境标识。development / test 允许使用开发默认值；
# production / staging / uat / demo 为生产类环境，会强制拒绝弱/默认 JWT_SECRET，
# 并拒绝通配 / 空 CORS 白名单。
APP_ENV=development

# JWT 签名密钥。生产类环境必须替换为至少 32 位的随机密钥，否则服务拒绝启动。
JWT_SECRET=replace-with-32-plus-char-random-secret

# CORS 白名单（英文逗号分隔）。替换原 `origin: true` 反射；生产类环境禁止 `*` / `true` / 空。
CORS_ORIGIN=http://localhost:5173,http://localhost:5566

# PBS 模拟登录的 live-server -> pbs-server 服务间鉴权密钥。
# 生成命令：openssl rand -base64 48
# 同一环境下必须与 pbs-server 的 PBS_INTERNAL_API_SECRET 完全一致；不要提交真实值。
PBS_INTERNAL_API_SECRET=O6+1q0STl8O+5id6dPepmF5A22MyTvO2vJGPK4cbVMrlgbvgDH0BU+dgZF6VJ8oO

# 内部 Prometheus /metrics 暴露控制。
# METRICS_ENABLED=false 时不注册 /metrics；生产类环境若开启必须设置 METRICS_TOKEN，
# 否则服务拒绝启动。设置后抓取需带 Authorization: Bearer <token> 或 X-Metrics-Token 头。
METRICS_ENABLED=true
# METRICS_TOKEN=replace_with_random_metrics_token

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/live_server
LIVE_SCHEMA=f8
SCENARIO_SCHEMA=scenario
PBS_SCHEMA=f8_pbs

# Redis（等价 Spring: spring.redis.host / port / password / database）
# 连接串: redis://[:密码@]主机:端口[/库索引]，密码中的特殊字符需 URL 编码
# 示例: redis://:yourPassword@192.168.199.208:6379/12
REDIS_URL=redis://localhost:6379/0

# BullMQ（通常与业务 Redis 同实例；可单独库或同库不同前缀）
BULLMQ_REDIS_URL=redis://localhost:6379/0

# 说明: 本服务会话为 JWT（非 Spring Session）。Spring 的 spring.session.* / cookie.path
# 由网关或前端另行配置；会话时长请与 JWT 签发策略对齐。

# Logging
LOG_LEVEL=info

# Roster Publish outbound callback scheduler.
# live-server claims and logs batches; connector-server owns third-party URL/token config.
ROSTER_PUBLISH_OUTBOUND_INTERVAL_MS=300000
ROSTER_SOFT_DELETE_RETENTION_MONTHS=1
ROSTER_SOFT_DELETE_CLEANUP_BATCH_SIZE=1000
ROSTER_SOFT_DELETE_CLEANUP_INTERVAL_MS=604800000

# ── Azure SAML SSO ───────────────────────────────────────────────
SSO_ENABLED=false
SSO_ENTITY_ID=urn:rois:gantt-sso
SSO_CALLBACK_URL=https://crew-f8-usva-uat.roiscloud.com/live/api/auth/sso/acs
SSO_IDP_ENTRY_POINT=https://login.microsoftonline.com/<tenant-id>/saml2
SSO_IDP_CERT=
SSO_PRIVATE_KEY=
SSO_PUBLIC_CERT=
SSO_REDIRECT_BASE=https://crew-f8-usva-uat.roiscloud.com/altair/
SSO_EMAIL_ATTRS=http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress,http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name
SSO_USERCODE_ATTRS=employeeId

# ── Redis key namespace ───────────────────────────────────────────────────
# Per-environment prefix prepended to every Redis key (BullMQ queues, cache,
# mutation locks, etc.) so dev/uat/sit/prod don't collide when sharing one
# Redis instance. Default 'dev' (zod fallback). Production-like APP_ENV
# refuses to start with default 'dev' or 'uat' — see config/env.ts superRefine.
# Use 'prod' for production, 'uat' for UAT, 'sit' for staging, 'dev' for dev.
REDIS_KEY_PREFIX=dev
