{
  "name": "live-server",
  "version": "0.1.0",
  "description": "Live server with Fastify and Drizzle ORM",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "node ../scripts/version-state.mjs bump live-server",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:generated-sql-coverage": "node --experimental-test-coverage --test-coverage-branches=50 --test-coverage-lines=88 --test-coverage-functions=92 --test-coverage-include='src/services/pairing-search/pairing-search-core-conditions.ts' --test-coverage-include='src/services/pairing-search/pairing-search-time-conditions.ts' --test-coverage-include='src/services/pairing-search/pairing-search-detail-conditions.ts' --import tsx --test src/services/pairing-search/generated-sql-preflight.coverage.ts",
    "verify:generated-sql": "node --env-file=.env scripts/verify-generated-pairing-sql.mjs",
    "verify:flyduties-sql": "node --env-file=.env scripts/verify-flyduties-sql.mjs",
    "verify:assignment-overlap-sql": "node --env-file=.env scripts/verify-assignment-overlap-sql.mjs",
    "verify:8072-sql": "node --env-file=.env scripts/verify-8072-sql.mjs",
    "verify:rule-batch-parity": "node --env-file=.env scripts/verify-rule-batch-parity.mjs --group 103 --from 2026-06-01 --to 2026-07-01 --division P && node --env-file=.env scripts/verify-rule-batch-parity.mjs --group 637 --from 2026-01-01 --to 2026-12-31 --division C",
    "test:watch": "vitest",
    "audit:prod": "npm audit --omit=dev",
    "audit:all": "npm audit"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^11.0.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "@node-saml/node-saml": "^5.1.0",
    "@rois/legality-messages": "file:../packages/legality-messages",
    "@rois/shared-rules": "file:../packages/shared-rules",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.30.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.0",
    "prom-client": "^15.1.3",
    "redis": "^4.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "fast-jwt": "^6.2.4",
    "fast-uri": "^3.1.2",
    "ws": "^8.21.0",
    "uuid": "^11.1.1",
    "postcss": "^8.5.15",
    "esbuild": "^0.28.1"
  }
}
