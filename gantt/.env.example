# Copy to .env.local (gitignored) and adjust for your local setup.

# Dev server
# VITE_PORT=5566

# Backend proxy targets (used by vite.config.ts proxy rules)
# VITE_LIVE_TARGET=http://127.0.0.1:8899
# VITE_RULE_TARGET=http://127.0.0.1:7788

# API base (kept for code that reads it directly; most code goes through /fpqe/* proxies)
VITE_API_BASE_URL=http://localhost:8899

# HMR — leave unset for direct http://host:port/ dev.
# Set these when serving via an HTTPS reverse proxy so the browser's WebSocket
# URL matches the proxy's hostname/port/protocol.
# VITE_HMR_PROTOCOL=wss
# VITE_HMR_CLIENT_PORT=443
# VITE_HMR_HOST=your.domain.com

# Azure SSO 登录入口；留空自动拼 {LIVE_API_BASE}/api/auth/sso/login
VITE_SSO_LOGIN_URL=
