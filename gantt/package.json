{
  "name": "gantt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gantt chart frontend with React 19 and Zustand",
  "scripts": {
    "generate:dev-skills": "node scripts/generate-dev-skills-data.mjs",
    "predev": "node ../scripts/version-state.mjs bump gantt && npm run generate:dev-skills",
    "dev": "vite",
    "prebuild": "node ../scripts/version-state.mjs bump gantt && npm run generate:dev-skills",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:prod": "npm audit --omit=dev",
    "audit:all": "npm audit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@rois/shared-rules": "file:../packages/shared-rules",
    "@rois/ui": "file:../packages/ui",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-virtual": "^3.14.9",
    "axios": "^1.7.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.40.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.2.2"
  }
}
