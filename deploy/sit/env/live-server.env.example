# live-server (Fastify, port 3000) — runs on the SIT PortalServer (10.16.11.18, ecs-user).
# Copy to /home/ecs-user/sit/env/live-server.env on 10.16.11.18 and fill in real values.
# NEVER commit the populated file; this template is the only tracked copy.

HOST=0.0.0.0
PORT=3000
APP_ENV=development
LOG_LEVEL=info

JWT_SECRET=replace-with-32-plus-char-random-secret
CORS_ORIGIN=https://crew-f8-usva-sit.roiscloud.com
# Generate with: openssl rand -base64 48
# Must match pbs-server PBS_INTERNAL_API_SECRET in the same environment
# (PBS server is not deployed in this SIT scope, but kept for live-server tests).
PBS_INTERNAL_API_SECRET=O6+1q0STl8O+5id6dPepmF5A22MyTvO2vJGPK4cbVMrlgbvgDH0BU+dgZF6VJ8oO

METRICS_ENABLED=false

# ── PostgreSQL ──────────────────────────────────────────────────────────
# DB + Redis are docker containers on 10.16.11.18 (same host as live-server);
# apps connect via localhost. Schema names are the legacy `dev_*` set that
# actually shipped to SIT before the `f8_sit_*` rename was discussed in CLAUDE.md;
# docs/architecture/data-model.md and this file together are the source of truth.
DATABASE_URL=postgresql://f8_sit_live:replace_with_sit_db_password@localhost:5432/recovery?options=-c%20search_path%3Ddev_live
LIVE_SCHEMA=dev_live
SCENARIO_SCHEMA=dev_scenario
PBS_SCHEMA=dev_pbs

# Redis (same Docker host, accessed via localhost — no SSH tunnel needed)
REDIS_URL=redis://localhost:6379/0
BULLMQ_REDIS_URL=redis://localhost:6379/0