# Build-time env for the SIT gantt — safe to commit (no secrets).
# Applied during `npm run build` on the deploy host (this workstation);
# static dist is written to /home/recovery/sit/gantt/ and served by the local
# nginx at the /altair/ location block (see deploy/sit/nginx/recovery-sit.conf).
VITE_BASE=/altair/
VITE_API_PREFIX=
VITE_APP_ENV=SIT
