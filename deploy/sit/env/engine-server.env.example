# engine-server (FastAPI, port 3003) — runs on the SIT PortalServer (10.16.11.18, ecs-user).
# Copy to /home/ecs-user/sit/env/engine-server.env on 10.16.11.18 and fill in real values.
# NEVER commit the populated file.

# ── PostgreSQL + Redis (Docker on 10.16.11.18, accessed via localhost) ──
DATABASE_URL=postgresql://f8_sit_live:replace_with_sit_db_password@localhost:5432/recovery?options=-c%20search_path%3Ddev_live
REDIS_URL=redis://localhost:6379/0
SCENARIO_DATABASE_URL=postgresql://f8_sit_scenario:replace_with_sit_db_password@localhost:5432/recovery?options=-c%20search_path%3Ddev_scenario

LIVE_SERVER_URL=http://localhost:3000

# JWT signing secret (MUST equal live-server.env JWT_SECRET exactly).
# engine-server/config.yaml uses secret: "${JWT_SECRET}"; auto-deploy rsyncs
# that template on every --engine push. service.sh inherits from
# live-server.env if this value is missing/placeholder, but refuses to start
# when both are empty.
JWT_SECRET=replace-with-same-value-as-live-server-jwt-secret
ROIS_API_KEY=your_api_key_here

# ── ro_rust.sh path overrides (this SIT layout) ──────────────────────────
# CONV_PY: legacy_ro_converter.py's Python (with psycopg2),
#   points at the venv created by deploy.sh push_engine() — not the default .venv.
RO_CONVERTER_PYTHON=/home/ecs-user/sit/engine-server/venv/bin/python

# Hydra experiment under the pre-installed solver tree on the SIT host.
# Successful SIT archives use deploy/sit. Do NOT use deploy/prod_0604 —
# that file lives under deploy/_0630_2/ and Hydra cannot resolve +experiments=deploy/prod_0604.
RO_EXPERIMENT=deploy/sit
# Solver + converter interpreters for the pre-installed SIT solver.
# These paths assume PBS_column_based_algorithm-main and miniforge flair-pbs-env
# are pre-installed on 10.16.11.18 by ops (NOT deployed by this script).
# Adjust if your SIT solver lives elsewhere.
RO_SOLVER_DIR=/home/ecs-user/PBS_column_based_algorithm-main
RO_SOLVER_PYTHON=/home/ecs-user/miniforge3/envs/flair-pbs-env/bin/python

# RO 法规数据源：SIT has no MySQL — must be pg (pure-PostgreSQL path).
# Set to mysql only if you also run a MySQL legacy-rules source.
RO_RULE_SOURCE=pg

# LEGACY_RO_DB_URL: legacy_ro_converter.py writes roster results back here.
LEGACY_RO_DB_URL=postgresql://f8_sit_live:replace_with_sit_db_password@localhost:5432/recovery?options=-c%20search_path%3Ddev_live

# PBS Server (LegacyRO period_code etc.) — not deployed in this SIT scope;
# keep commented to disable PBS_SERVER calls until pbs-server ships.
# PBS_SERVER_URL=http://localhost:3002
# PBS_ADMIN_USER=900
# PBS_ADMIN_PASSWORD=rois

# live-server admin credentials for the bid/preference package download.
# config.yaml resolves ${BID_PACKAGE_ADMIN_USER}/${BID_PACKAGE_ADMIN_PASSWORD}.
# Requires an is_admin=1 account; the yeg-test-package export endpoint rejects non-admin users.
BID_PACKAGE_SERVER_URL=http://localhost:3000
BID_PACKAGE_ADMIN_USER=admin
BID_PACKAGE_ADMIN_PASSWORD=123456

# ── PBS column-generation solver pipeline ──────────────────────────────────
# run_pipeline.sh pre-installed on the SIT PortalServer, called as a subprocess
# by engine-server. Path MUST match the actual ops-installed location.
PBS_PIPELINE_SCRIPT=/home/ecs-user/PBS_column_based_algorithm-main/run_pipeline.sh