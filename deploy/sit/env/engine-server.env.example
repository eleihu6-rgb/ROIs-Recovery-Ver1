# engine-server (FastAPI, port 3003)
# Copy to /home/rois/sit/env/engine-server.env on PortalServer and fill in real values.

DATABASE_URL=postgresql://f8_sit_live:replace_with_sit_db_password@10.15.12.3:5432/rois?options=-c%20search_path%3Df8_sit_live
REDIS_URL=redis://10.15.12.3:6379/0
SCENARIO_DATABASE_URL=postgresql://f8_sit_scenario:replace_with_sit_db_password@10.15.12.3:5432/rois?options=-c%20search_path%3Df8_sit_scenario

LIVE_SERVER_URL=http://localhost:3000

# JWT 认证密钥（必须与 live-server.env 的 JWT_SECRET 相同）。
# engine-server/config.yaml 使用 secret: "${JWT_SECRET}"；auto-deploy 每次 --engine
# 都会 rsync 覆盖 config.yaml。若此处缺失，service.sh 会尝试从 live-server.env 继承，
# 仍缺失则拒绝启动（避免静默 401 Invalid authentication credentials）。
JWT_SECRET=replace-with-same-value-as-live-server-jwt-secret
ROIS_API_KEY=your_api_key_here

# ── ro_rust.sh 路径覆盖（SIT PortalServer 路径）─────────────────
# CONV_PY：legacy_ro_converter.py 所用 Python（含 psycopg2），
#   指向 deploy.sh push_engine() 创建的 venv（而非默认的 .venv）
RO_CONVERTER_PYTHON=/home/rois/sit/engine-server/venv/bin/python

# Hydra experiment under /home/rois/PBS_column_based_algorithm-main/conf/experiments/
# (must exist as a group path).
# Successful SIT archives used deploy/sit. Do NOT use deploy/prod_0604 — that file
# lives under deploy/_0630_2/ and Hydra cannot resolve +experiments=deploy/prod_0604.
RO_EXPERIMENT=deploy/sit
# Solver + converter interpreters for the pre-installed SIT solver.
RO_SOLVER_DIR=/home/rois/PBS_column_based_algorithm-main
RO_SOLVER_PYTHON=/root/miniforge3/envs/flair-pbs-env/bin/python

# RO 法规数据源：SIT 无 MySQL，必须设为 pg（走纯 PostgreSQL 路径）
# 生产如需读取 MySQL 遗留法规表则改为 mysql，并配 MYSQL_* 变量
RO_RULE_SOURCE=pg

# LEGACY_RO_DB_URL：legacy_ro_converter.py 写回排班结果所用的 PG 连接串
LEGACY_RO_DB_URL=postgresql://f8_sit_live:replace_with_sit_db_password@10.15.12.3:5432/rois?options=-c%20search_path%3Df8_sit_live

# PBS Server（LegacyRO period_code 等参数来源）
PBS_SERVER_URL=http://localhost:3002
PBS_ADMIN_USER=900
PBS_ADMIN_PASSWORD=rois

# live-server admin credentials for the bid/preference package download.
# config.yaml resolves ${BID_PACKAGE_ADMIN_USER}/${BID_PACKAGE_ADMIN_PASSWORD}.
# Requires an is_admin=1 account; the yeg-test-package export endpoint rejects non-admin users.
BID_PACKAGE_SERVER_URL=http://localhost:3000
BID_PACKAGE_ADMIN_USER=admin
BID_PACKAGE_ADMIN_PASSWORD=123456

# ── PBS 列生成优化引擎（PBS_column_based_algorithm）─────────────────
# run_pipeline.sh 预装在 PortalServer /home/rois/，由 engine-server 作为子进程调用。
# 无需修改路径（除非算法目录迁移）。
PBS_PIPELINE_SCRIPT=/home/rois/PBS_column_based_algorithm-main/run_pipeline.sh
