HOST=0.0.0.0
PORT=3002
APP_ENV=development
LOG_LEVEL=info

JWT_SECRET=replace-with-32-plus-char-random-secret
JWT_EXPIRES_IN=24h
CORS_ORIGIN=https://crew-f8-usva-tst.roiscloud.com
# Generate with: openssl rand -base64 48
# Must match live-server PBS_INTERNAL_API_SECRET in the same environment.
PBS_INTERNAL_API_SECRET=O6+1q0STl8O+5id6dPepmF5A22MyTvO2vJGPK4cbVMrlgbvgDH0BU+dgZF6VJ8oO
# PBS portal public URL and simulated-login TTL are stored in live.dictionary SYS_PARAM.

METRICS_ENABLED=false

# CoreServer PostgreSQL (SIT isolated PBS schema)
DATABASE_URL=postgresql://f8_sit_pbs:replace_with_sit_db_password@10.15.12.3:5432/rois?options=-c%20search_path%3Df8_sit_pbs
DATABASE_CONNECTION_TIMEOUT_MS=15000
PBS_SCHEMA=f8_sit_pbs
LIVE_SCHEMA=f8_sit_live

SOURCE_DATABASE_URL=postgresql://f8_sit_live:replace_with_sit_db_password@10.15.12.3:5432/rois?options=-c%20search_path%3Df8_sit_live
SOURCE_SCHEMA=f8_sit_live
TARGET_DATABASE_URL=postgresql://f8_sit_pbs:replace_with_sit_db_password@10.15.12.3:5432/rois?options=-c%20search_path%3Df8_sit_pbs
TARGET_SCHEMA=f8_sit_pbs
PBS_SYNC_CREW_ID_FIELD=user_code
PBS_SYNC_UPDATED_BY=pbs-user-sync
PBS_USER_EFFECTIVE_DATE_LOCK_TIMEOUT_MS=5000

# CoreServer Redis（PBS 专用，与 live-server 的 REDIS_URL 共用同一 Redis 实例但用独立 db index 隔离）
# 与 live-server.env 的 REDIS_URL 保持同一连接方式：本地开发直连 10.15.12.3，
# PortalServer 部署时需改为 SSH 隧道地址 127.0.0.1:16379（见 service.sh start_tunnel）
REDIS_PBS_URL=redis://10.15.12.3:6379/1
