PORT=3004
HOST=0.0.0.0
APP_ENV=development
LOG_LEVEL=info

# PortalServer SIT uses the CoreServer Redis tunnel opened by service.sh.
REDIS_URL=redis://127.0.0.1:16379/7
BULLMQ_REDIS_URL=redis://127.0.0.1:16379/6

# Fill with the SIT live database URL on PortalServer; do not commit real secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=disable

# Must match live-server.env so live admin JWTs can call connector admin routes.
JWT_SECRET=replace-with-same-value-as-live-server-jwt-secret

METRICS_ENABLED=false
LIVE_SCHEMA=f8_sit_live
PBS_SCHEMA=f8_sit_pbs
CORS_ORIGIN=https://crew-f8-usva-sit.roiscloud.com
