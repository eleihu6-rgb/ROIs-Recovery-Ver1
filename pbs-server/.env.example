# PBS 服务绑定地址。
# 本地开发保持 0.0.0.0 时，可以同时通过 localhost 和局域网地址访问。
HOST=0.0.0.0

# PBS 服务监听端口。
# pbs-portal 本地开发时会把 /api 代理到这个端口。
PORT=3002

# 部署环境标识。development / test 允许使用开发默认值；
# production / staging / uat / demo 为生产类环境，会强制拒绝弱/默认 JWT_SECRET。
APP_ENV=development

# Fastify 日志级别。
# 可选值见 src/config/env.ts：fatal、error、warn、info、debug、trace。
LOG_LEVEL=info

# 内部 Prometheus /metrics 暴露控制。
# METRICS_ENABLED=false 时不注册 /metrics；生产类环境若开启必须设置 METRICS_TOKEN，
# 否则服务拒绝启动。设置 METRICS_TOKEN 后，抓取需带 Authorization: Bearer <token>
# 或 X-Metrics-Token 头。
METRICS_ENABLED=true
# METRICS_TOKEN=replace_with_random_metrics_token

# 本地 CORS 白名单来源。
# 如果后续有更多前端地址需要访问，可以用英文逗号分隔追加。
CORS_ORIGIN=http://localhost:3030

# PBS 服务运行时使用的主数据库连接串。
# search_path 应指向 PBS schema，这样路由和 service 才会正确访问 pbs_user 等对象。
# 占位符密码：复制为 .env 后替换为真实密码。
DATABASE_URL=postgresql://f8_pbs:replace_with_pbs_db_password@localhost:5432/rois?options=-c%20search_path%3Df8_pbs

# PBS 服务启动时等待数据库连接建立的超时时间，单位毫秒。
# 远程数据库在本地开发时偶尔响应较慢，默认建议 15000。
DATABASE_CONNECTION_TIMEOUT_MS=15000

# PBS 专用 Redis 连接串。
# 本地 docker-compose 中 redis-pbs 默认映射到 localhost:6380。
# 生产 / UAT 必须使用 PBS 独立 Redis，不要复用 live-server 的 REDIS_URL。
REDIS_PBS_URL=redis://localhost:6380

# PBS schema 名称。
# 这里要和 DATABASE_URL 里的 search_path 保持一致。
PBS_SCHEMA=f8_pbs

# Live schema 名称。PBS 读取 crew / pairing / roster_period 等 live 数据时使用。
LIVE_SCHEMA=f8

# PBS 密码登录签发 JWT 时使用的密钥。
# 本地如果有多个 PBS server 实例需要互认 token，必须保持同一个值。
# 生产类环境（APP_ENV=production/staging/uat/demo 或 NODE_ENV=production）必须替换为
# 至少 32 位的随机密钥，否则服务拒绝启动。
JWT_SECRET=replace-with-32-plus-char-random-secret

# POST /api/auth/session 返回的 Bearer token 有效期。
# 常见写法如 24h、12h、7d。
JWT_EXPIRES_IN=24h

# PBS 模拟登录的 live-server -> pbs-server 服务间鉴权密钥。
# 生成命令：openssl rand -base64 48
# 同一环境下必须与 live-server 的 PBS_INTERNAL_API_SECRET 完全一致；不要提交真实值。
# PBS portal public URL 和 simulated-login TTL 存在 live.dictionary 的 SYS_PARAM，不放在 env。
PBS_INTERNAL_API_SECRET=O6+1q0STl8O+5id6dPepmF5A22MyTvO2vJGPK4cbVMrlgbvgDH0BU+dgZF6VJ8oO

# RUST 法规 core 文件路径（live-server 的 legality-recheck-core.mjs，单一来源，动态 import）。
# 默认相对 pbs-server 的 ../live-server/scripts/legality-recheck-core.mjs，一般无需覆盖。
# RUST_RULE_CORE=../live-server/scripts/legality-recheck-core.mjs

# users -> pbs_user 同步脚本读取源数据时使用的数据库连接串。
# 这里应该指向 live-server 的 users 所在 schema，而不是 PBS schema。
SOURCE_DATABASE_URL=postgresql://f8:replace_with_f8_password@localhost:5432/rois?options=-c%20search_path%3Df8

# 同步源 schema。
# 当前 PBS 对齐方案默认 live-server 的 users 表位于这个 schema。
SOURCE_SCHEMA=f8

# 同步脚本写入目标数据时使用的数据库连接串。
# 一般可以与 DATABASE_URL 相同，但单独拆出来后，后续也能支持同步到其他库。
TARGET_DATABASE_URL=postgresql://f8_pbs:replace_with_pbs_db_password@localhost:5432/rois?options=-c%20search_path%3Df8_pbs

# 同步目标 PBS schema。
# 这里要和 TARGET_DATABASE_URL、PBS_SCHEMA 保持一致。
TARGET_SCHEMA=f8_pbs

# 源 users 表中映射到 pbs_user.crew_id 的字段名。
# 当前本地配置明确使用 user_code 作为 crew_id 的映射来源。
PBS_SYNC_CREW_ID_FIELD=user_code

# 同步 upsert 时写入 created_by / updated_by 的审计账号。
# 建议使用稳定的技术账号名，方便后续追踪哪些更新来自同步脚本。
PBS_SYNC_UPDATED_BY=pbs-user-sync

# PBS 用户同步与 BC 生效日期规范化共享的事务锁等待上限（毫秒）。
PBS_USER_EFFECTIVE_DATE_LOCK_TIMEOUT_MS=5000

# ── Azure SAML SSO ───────────────────────────────────────────────
SSO_ENABLED=false
SSO_ENTITY_ID=urn:rois:pbs-sso
SSO_CALLBACK_URL=https://crew-f8-usva-uat.roiscloud.com/pbs/api/auth/sso/acs
SSO_IDP_ENTRY_POINT=https://login.microsoftonline.com/<tenant-id>/saml2
SSO_IDP_CERT=
SSO_PRIVATE_KEY=
SSO_PUBLIC_CERT=
SSO_REDIRECT_BASE=https://crew-f8-usva-uat.roiscloud.com/pbs/login
SSO_EMAIL_ATTRS=http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress,http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name
SSO_USERCODE_ATTRS=employeeId
